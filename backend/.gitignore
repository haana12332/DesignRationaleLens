# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets (compiled).
/public/assets

# Ignore Kamal deploy config (contains secrets).
/config/deploy*.yml
/.kamal

# Ignore local database config if it contains credentials.
# /config/database.yml

# Miscellaneous
*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/rdoc/
/.yardoc/
/_yardoc/
/doc/

# Ruby versioning
/.rvmrc

# Vendor bundled gems
/vendor/bundle/
